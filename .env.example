# ── Coco-Plus environment variables ──────────────────────────────
# Copy this file to .env and fill in the values you need.
# CLI args and config.toml take priority over these.

# Provider: "anthropic" or "openai"
# COCO_PROVIDER=anthropic

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=

# OpenAI-compatible (e.g. DashScope, local LLM)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model override
# COCO_MODEL=claude-sonnet-4
# COCO_MAX_TOKENS=16384
