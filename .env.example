# ── Coco environment variables ──────────────────────────────
# Copy this file to .env and fill in the values you need.
# CLI args and config.toml take priority over these.

# Provider: "anthropic" | "openai" | "openrouter"
# COCO_PROVIDER=anthropic

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=

# OpenAI-compatible (e.g. DashScope, local LLM)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenRouter (unified gateway for 300+ models)
# Default base_url is https://openrouter.ai/api/v1 — leave commented to use it.
# Model names use namespace/slug form, e.g. anthropic/claude-sonnet-4-5, openai/gpt-5.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=

# Model override
# COCO_MODEL=claude-sonnet-4
# COCO_MAX_TOKENS=16384

# OpenRouter-only: comma-separated fallback models.
# If the primary model fails (rate-limit, context-too-long, downtime),
# OpenRouter automatically retries the next one in order, billed by actual usage.
# Ignored for provider=anthropic / provider=openai.
# COCO_FALLBACK_MODELS=openai/gpt-5,google/gemini-2.5-pro
